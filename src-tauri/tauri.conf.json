{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "uxuescript",
  "version": "2.0.1",
  "identifier": "top.unraous.uxs",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1425",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
